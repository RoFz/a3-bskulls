{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "always-update": true,
  "packages": {
    "bskulls-coldwar": {
      "changelog-path": "CHANGELOG.md",
      "component": "bskulls-coldwar",
      "extra-files": [
        {
          "path": "addons/bskulls-coldwar/CfgPatches.hpp",
          "type": "generic"
        },
        {
          "path": ".hemtt/project.toml",
          "type": "generic"
        }
